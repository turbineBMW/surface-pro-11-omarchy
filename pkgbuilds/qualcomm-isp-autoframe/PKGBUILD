# Maintainer: Brandon Williams <turbine.bmw@gmail.com>
# Built from turbineBMW/qualcomm-isp at the tag below; the recipe there is
# the reference (packaging/autoframe). Bump _tag and pkgrel together.
#
# Automatic framing for the ISP front camera: a GStreamer element the camera
# publisher loads through /etc/qualcomm-isp/publisher.d, following the face(s)
# with a YuNet detector (OpenCV, CPU) and cropping the ISP's 4K output to
# 1080p around them, like Windows Studio Effects. isp-autoframe switches and
# tunes it; `isp-autoframe plugin install` adds the Omarchy bar widget.
pkgname=qualcomm-isp-autoframe
pkgver=0.1
pkgrel=1
pkgdesc='Automatic framing (face-following crop) for the Qualcomm ISP front camera publisher'
arch=('aarch64')
url='https://github.com/turbineBMW/qualcomm-isp'
license=('MIT' 'Apache-2.0')
depends=('gstreamer' 'gst-plugins-base-libs' 'opencv' 'qualcomm-isp-runtime>=0.1-20')
makedepends=('git' 'meson' 'ninja' 'pkgconf')
backup=('etc/qualcomm-isp/publisher.d/50-autoframe.json')
install=qualcomm-isp-autoframe.install
options=('!debug')
_tag=v0.1-20
# YuNet (Apache-2.0), pinned to an OpenCV Zoo commit.
_zoo=48b10fa505aeb51fbd127fc60a5c660040e823b7
source=("qualcomm-isp::git+$url.git#tag=$_tag"
        "face_detection_yunet_2023mar-${_zoo:0:7}.onnx::https://github.com/opencv/opencv_zoo/raw/$_zoo/models/face_detection_yunet/face_detection_yunet_2023mar.onnx")
sha256sums=('b09f7f5e66014be2e637cad50e1edab113191b9ad3bcaa0a23d4b409ba053917'
            '8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4')

build() {
  arch-meson qualcomm-isp/autoframe build
  meson compile -C build
}

package() {
  local a=qualcomm-isp/autoframe
  DESTDIR="$pkgdir" meson install -C build
  install -Dm644 "face_detection_yunet_2023mar-${_zoo:0:7}.onnx" \
    "$pkgdir/usr/share/qualcomm-isp/face_detection_yunet_2023mar.onnx"
  install -Dm755 "$a/bin/isp-autoframe" "$pkgdir/usr/bin/isp-autoframe"
  install -Dm644 "$a/publisher.d/50-autoframe.json" "$pkgdir/etc/qualcomm-isp/publisher.d/50-autoframe.json"
  # Omarchy bar widget; `isp-autoframe plugin install` copies it into the
  # user's plugin directory and enables it.
  install -Dm644 "$a/omarchy/plugins/isp.autoframe/manifest.json" \
    "$pkgdir/usr/share/qualcomm-isp/omarchy/plugins/isp.autoframe/manifest.json"
  install -Dm644 "$a/omarchy/plugins/isp.autoframe/Panel.qml" \
    "$pkgdir/usr/share/qualcomm-isp/omarchy/plugins/isp.autoframe/Panel.qml"
  install -Dm644 qualcomm-isp/LICENSES/MIT.txt "$pkgdir/usr/share/licenses/$pkgname/MIT.txt"
  install -Dm644 qualcomm-isp/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$a/README.md" "$pkgdir/usr/share/doc/qualcomm-isp/AUTOFRAME-README.md"
  install -Dm644 qualcomm-isp/docs/AUTOFRAME.md "$pkgdir/usr/share/doc/qualcomm-isp/AUTOFRAME.md"
}
