pkgname=surface-pro-11-face
pkgver=1
pkgrel=4
pkgdesc="Face unlock for the Surface Pro 11's IR camera: camera wiring, facelock quirk and setup"
arch=('any')
url="https://github.com/turbineBMW/surface-pro-11-omarchy"
license=('MIT')
depends=('facelock' 'v4l-utils' 'python')
install=$pkgname.install
replaces=('surface-pro-11-ir')
conflicts=('surface-pro-11-ir')
source=('surface-pro-11-ir-graph' '70-surface-pro-11-ir.rules' 'surface-pro-11-ir-camera.service'
        '60-surface-pro-11-ir.toml' 'surface-pro-11-face-setup' 'surface-pro-11-face-remove')
sha256sums=('25846f1d8ab1475a4ff6a877b143664ccabad9ed0807712bdb2c126817df64f0'
            '185bcafe0fb9e1a7cba9a74449b935e5e851471baee66d40427a1e3d064012ed'
            '66e75ba41cef67f4f06eb7921aabb32c2918dd24b56ce618bad5ffdbdb0a39ed'
            '87c070138f832b7a9fb371eb7b029a1fad523f0234a753af7892257881ad2eb2'
            '914f657a198265df259b77b582e197a0214966d6913bc69eeb86837eb539714f'
            'cbb3fa884b9fc0fa7a9fcc3170e7801b1b89c7a8b9b0ed5852b609c86fda89fc')

package() {
  install -Dm755 surface-pro-11-ir-graph "$pkgdir/usr/lib/$pkgname/surface-pro-11-ir-graph"
  install -Dm644 70-surface-pro-11-ir.rules "$pkgdir/usr/lib/udev/rules.d/70-surface-pro-11-ir.rules"
  install -Dm644 surface-pro-11-ir-camera.service "$pkgdir/usr/lib/systemd/system/surface-pro-11-ir-camera.service"
  install -Dm644 60-surface-pro-11-ir.toml "$pkgdir/usr/share/facelock/quirks.d/60-surface-pro-11-ir.toml"
  install -Dm755 -t "$pkgdir/usr/bin" surface-pro-11-face-setup surface-pro-11-face-remove
}
