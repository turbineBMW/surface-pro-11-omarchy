# Maintainer: Brandon Williams <turbine.bmw@gmail.com>

# Hardware support for the Microsoft Surface Pro 11 (Snapdragon X Elite, OLED)
# that no upstream package carries yet.

pkgname=surface-pro-11-support
pkgver=1
pkgrel=5.5
pkgdesc="Hardware support for the Microsoft Surface Pro 11 (Snapdragon X Elite) not yet carried upstream"
arch=('aarch64')
# Qualcomm-only: the pacman platform guard keeps it off other hardware.
groups=('omarchy-platform-qualcomm')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT' 'BSD-3-Clause' 'LicenseRef-QualcommAtheros-ath10k')
# linux-firmware-qcom ships the AudioReach topology from 20261019-1.1, which
# carries Qualcomm's v1.0.5 sync.
depends=('alsa-ucm-conf' 'bluez' 'bluez-utils' 'ddcutil' 'linux-firmware-qcom>=20261019-1.1'
         'lsp-plugins-lv2' 'pipewire' 'python' 'surface-snapdragon-addresses' 'upower>=1.91.5-1.1'
         'wireplumber')
optdepends=('iptsd: pen and touch, restarted across suspend by this package')
makedepends=('alsa-ucm-conf' 'linux-firmware-atheros' 'python' 'zstd')
# The board data is an ELF image; stripping it corrupts the record.
options=('!debug' '!strip')
source=(
  'MICROSOFT-Surface-Pro-11.conf'
  'Surface11-HiFi.conf'
  'extract-ath12k-board.py'
  '50-surface-pro-11-cameras.conf'
  '50-surface-pro-11-speakers.conf'
  '51-surface-pro-11-speakers.conf'
  'dolby2pipewire.py'
  'imx681.yaml'
  'surface-pro-11-charge-limit-sleep'
  'surface-pro-11-iptsd-sleep'
  'surface-pro-11-lid-wake-sleep'
  'surface-pro-11-touchpad-mode-sleep'
  'surface-pro-11-flex-pair'
  'surface-pro-11-flex-autopair'
  'surface-pro-11-flex-reconnect'
  'surface-pro-11-flex-autopair.service'
  'surface-pro-11-flex-reconnect.service'
  'surface-pro-11-pen-pair'
  'surface-pro-11-pen-forget'
  'ddc-vcp'
  'surface-pro-11-brightness-sync'
  'surface-pro-11-brightness-sync.service'
  'surface-pro-11-battery-info'
  'surface-pro-11-battery-info.service'
  'surface-pro-11-battery-info.timer'
  'omarchy-menu.jsonc'
  '70-surface-pro-11-battery.rules'
  '50-surface-pro-11-psr.conf'
  '70-surface-pro-11-flex-keyboard.rules'
  '50-surface-pro-11-flex-keyboard.quirks'
  'README.package.md'
  'LICENSE'
)
