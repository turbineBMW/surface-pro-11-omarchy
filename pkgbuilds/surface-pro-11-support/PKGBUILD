# The Surface reports generic WCN7850 identifiers (subsystem 17cb:1107,
# board-id 255) that match no board-2.bin entry. This is Qualcomm's own
# reference-design record from linux-firmware, not Surface calibration; it
# brings Wi-Fi up until linux-firmware carries a Surface Pro 11 entry.
_board_record='bus=pci,vendor=17cb,device=1107,subsystem-vendor=17cb,subsystem-device=3378,qmi-chip-id=2,qmi-board-id=255'
_board_bytes=88872
_board_sha256=0ef5f6f3cb124f33c6de52371819ccd7c13763ceb86d476a178fd56e4cdc26a3

build() {
  local container=/usr/lib/firmware/ath12k/WCN7850/hw2.0/board-2.bin
  if [[ ! -f $container && -f $container.zst ]]; then
    zstd -dq "$container.zst" -o board-2.bin
    container=board-2.bin
  fi
  rm -f board.bin
  python extract-ath12k-board.py --expected-bytes "$_board_bytes" \
    --expected-sha256 "$_board_sha256" "$container" "$_board_record" board.bin
}

package() {
  install -Dm644 board.bin "$pkgdir/usr/lib/firmware/ath12k/WCN7850/hw2.0/board.bin"
  # Compressed, so linux-firmware's copy is the one the kernel loads once it ships
  # a Surface Pro 11 board file (it tries a plain name, then .zst, then .xz), and
  # the two packages never install the same path.
  find "$pkgdir/usr/lib/firmware" -type f -exec xz -C crc32 {} +

  # Its own folder: alsa-ucm-conf ships different Surface Pro 11 files at
  # Qualcomm/x1e80100/ since 2026, and the conf.d links below keep this
  # tuned profile ahead of them.
  local ucm=/usr/share/alsa/ucm2
  install -Dm644 MICROSOFT-Surface-Pro-11.conf "$pkgdir$ucm/Qualcomm/surface-pro-11/MICROSOFT-Surface-Pro-11.conf"
  install -Dm644 Surface11-HiFi.conf "$pkgdir$ucm/Qualcomm/surface-pro-11/Surface11-HiFi.conf"
  install -d "$pkgdir$ucm/conf.d/x1e80100"
  local name
  for name in X1E80100-Microsoft-Surface-Pro-11.conf \
    MicrosoftCorporation-MicrosoftSurfacePro11thEdition-124I00117T000M0000000F0.conf; do
    ln -s ../../Qualcomm/surface-pro-11/MICROSOFT-Surface-Pro-11.conf "$pkgdir$ucm/conf.d/x1e80100/$name"
  done

  install -Dm644 50-surface-pro-11-cameras.conf \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/50-surface-pro-11-cameras.conf"
  install -Dm644 50-surface-pro-11-speakers.conf \
    "$pkgdir/usr/share/pipewire/pipewire.conf.d/50-surface-pro-11-speakers.conf"
  install -Dm644 51-surface-pro-11-speakers.conf \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/51-surface-pro-11-speakers.conf"
  install -Dm755 dolby2pipewire.py "$pkgdir/usr/lib/$pkgname/dolby2pipewire.py"
  install -Dm644 imx681.yaml "$pkgdir/usr/share/libcamera/ipa/simple/imx681.yaml"

  install -Dm755 surface-pro-11-charge-limit-sleep "$pkgdir/usr/lib/systemd/system-sleep/surface-pro-11-charge-limit"
  install -Dm755 surface-pro-11-iptsd-sleep "$pkgdir/usr/lib/systemd/system-sleep/surface-pro-11-iptsd"
  install -Dm755 surface-pro-11-lid-wake-sleep "$pkgdir/usr/lib/systemd/system-sleep/surface-pro-11-lid-wake"
  install -Dm755 surface-pro-11-touchpad-mode-sleep "$pkgdir/usr/lib/systemd/system-sleep/surface-pro-11-touchpad-mode"

  install -Dm755 surface-pro-11-flex-pair "$pkgdir/usr/bin/surface-pro-11-flex-pair"
  install -Dm755 surface-pro-11-flex-autopair "$pkgdir/usr/lib/$pkgname/surface-pro-11-flex-autopair"
  install -Dm755 surface-pro-11-flex-reconnect "$pkgdir/usr/lib/$pkgname/surface-pro-11-flex-reconnect"
  install -Dm755 surface-pro-11-pen-pair "$pkgdir/usr/bin/surface-pro-11-pen-pair"
  install -Dm755 surface-pro-11-pen-forget "$pkgdir/usr/bin/surface-pro-11-pen-forget"
  # Menu rows (Setup > Input > Pair Pen, Remove > Input > Pen); surface-pro-11-plugins adds them to the user's menu
  install -Dm644 omarchy-menu.jsonc "$pkgdir/usr/share/$pkgname/omarchy-menu.jsonc"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" \
    surface-pro-11-flex-autopair.service surface-pro-11-flex-reconnect.service
  install -Dm644 70-surface-pro-11-flex-keyboard.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-surface-pro-11-flex-keyboard.rules"
  install -Dm644 50-surface-pro-11-flex-keyboard.quirks \
    "$pkgdir/usr/share/libinput/50-surface-pro-11-flex-keyboard.quirks"
  install -Dm644 70-surface-pro-11-battery.rules "$pkgdir/usr/lib/udev/rules.d/70-surface-pro-11-battery.rules"

  # Kernel command line: panel self-refresh. /etc/limine-entry-tool.d/ is read
  # after this folder, so a local file there can switch it off again.
  install -Dm644 50-surface-pro-11-psr.conf \
    "$pkgdir/usr/share/limine-entry-tool.d/50-surface-pro-11-psr.conf"

  # External monitor brightness follows the screen's; on for every user, who
  # can mask it (systemctl --user mask surface-pro-11-brightness-sync)
  install -Dm755 ddc-vcp "$pkgdir/usr/lib/$pkgname/ddc-vcp"
  install -Dm755 surface-pro-11-brightness-sync "$pkgdir/usr/lib/$pkgname/surface-pro-11-brightness-sync"
  install -Dm644 surface-pro-11-brightness-sync.service \
    "$pkgdir/usr/lib/systemd/user/surface-pro-11-brightness-sync.service"
  install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../surface-pro-11-brightness-sync.service \
    "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/surface-pro-11-brightness-sync.service"

  # The battery cycle count, which only the Surface EC has: read at boot and
  # hourly into /run/surface-pro-11-battery for the battery card.
  install -Dm755 surface-pro-11-battery-info "$pkgdir/usr/lib/$pkgname/surface-pro-11-battery-info"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" \
    surface-pro-11-battery-info.service surface-pro-11-battery-info.timer
  install -d "$pkgdir/usr/lib/systemd/system/timers.target.wants"
  ln -s ../surface-pro-11-battery-info.timer \
    "$pkgdir/usr/lib/systemd/system/timers.target.wants/surface-pro-11-battery-info.timer"

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /usr/share/licenses/alsa-ucm-conf/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.alsa-ucm-conf"
  install -Dm644 /usr/share/licenses/linux-firmware-atheros/LICENSE.QualcommAtheros_ath10k \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.QualcommAtheros_ath10k"
}
