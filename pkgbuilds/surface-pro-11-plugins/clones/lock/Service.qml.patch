+  function refreshFaceStatus() {
+    if (!faceCheckProc.running) faceCheckProc.running = true
+  }
+
+  function startFace(explicit) {
+    if (!lockRequested || !sessionLock.secure || !faceConfigured) return
+    if (facePam.active || faceAuthenticating || authenticatingPassword) return
+    if (!explicit) {
+      if (faceAutoAttempts >= faceAutoLimit) return
+      faceAutoAttempts += 1
+    }
+
+    faceExplicit = !!explicit
+    faceAuthenticating = true
+    failureMessage = ""
+    if (!facePam.start()) {
+      faceAuthenticating = false
+      faceExplicit = false
+    }
+  }
+
+  // Someone is at the machine: a fresh set of automatic scans, unless they
+  // are typing a password.
+  function wakeFace() {
+    if (!lockRequested || !faceConfigured || enteredPassword.length > 0) return
+    faceAutoAttempts = 0
+    startFace(false)
+  }
+
+  function handleFaceFinished(success) {
+    var wasExplicit = faceExplicit
+    faceAuthenticating = false
+    faceExplicit = false
+
+    if (!lockRequested) return
+    if (success) {
+      finishUnlock()
+      return
+    }
+    if (wasExplicit) {
+      failureMessage = Commons.I18n.t("lock.faceNotRecognized", "Face not recognized")
+      runWake()
+    }
+    if (faceConfigured && faceAutoAttempts < faceAutoLimit) faceRetryTimer.restart()
+  }
+
