+  // Ambient-light auto-brightness (iio-sensor-proxy). Lives with the widget, so it
+  // runs whether or not the panel is open.
+  AutoBrightness {
+    id: autoBrightness
+    onAdjusted: function(percent) { root.brightnessPercent = percent }
+  }
+
+  function autoBrightnessIpc(mode) {
+    var m = String(mode || "").toLowerCase()
+    if (m === "on" || m === "true" || m === "1") autoBrightness.setActive(true)
+    else if (m === "off" || m === "false" || m === "0") autoBrightness.setActive(false)
+    else if (m === "toggle") autoBrightness.setActive(!autoBrightness.active)
+    return autoBrightness.status()
+  }
+
