@@ -20,6 +20,12 @@
   property string activeProfile: ""
   property int profileIndex: 0
   property bool cursorActive: false
+  // Battery charge limit through UPower's EnableChargeThreshold, which needs
+  // no password. The limit itself is UPower's (ChargeEndThreshold).
+  property string upowerBattery: ""
+  property bool chargeLimitSupported: false
+  property bool chargeLimitEnabled: false
+  property int chargeLimitEnd: 80
   readonly property bool showPercentage: setting("showPercentage", false) === true
   // With the percentage shown the button paints a text block wider than an
   // icon, so the open-panel mark takes the painted width instead of the
@@ -145,6 +151,26 @@
     if (!batteryProc.running) batteryProc.running = true
     if (!profilesProc.running) profilesProc.running = true
     if (!systemProc.running) systemProc.running = true
+    if (!chargeLimitProc.running) chargeLimitProc.running = true
+  }
+
+  function updateChargeLimit(raw) {
+    // Lines: object path, then ChargeThresholdSupported, ChargeThresholdEnabled,
+    // ChargeEndThreshold as busctl prints them ("b true", "u 80").
+    var lines = String(raw || "").trim().split("\n")
+    if (lines.length < 4) return
+    upowerBattery = lines[0].trim()
+    chargeLimitSupported = lines[1].trim() === "b true"
+    chargeLimitEnabled = lines[2].trim() === "b true"
+    var end = parseInt(lines[3].trim().split(" ")[1])
+    if (end > 0) chargeLimitEnd = end
+  }
+
+  function setChargeLimit(enabled) {
+    if (!upowerBattery || chargeLimitSetProc.running) return
+    chargeLimitSetProc.command = ["busctl", "call", "org.freedesktop.UPower", upowerBattery,
+      "org.freedesktop.UPower.Device", "EnableChargeThreshold", "b", enabled ? "true" : "false"]
+    chargeLimitSetProc.running = true
   }
 
   function updateKeyValue(raw, targetName) {
@@ -238,6 +264,24 @@
     onExited: root.refresh()
   }
 
+  Process {
+    id: chargeLimitProc
+    // Use the first battery UPower can set thresholds on. On the Surface Pro 11
+    // that is qcom_battmgr_bat; the Surface aggregator's BAT1 has no support.
+    command: ["sh", "-c",
+      "for p in $(upower -e | grep /battery_); do " +
+      "busctl get-property org.freedesktop.UPower \"$p\" org.freedesktop.UPower.Device " +
+      "ChargeThresholdSupported | grep -q true || continue; echo \"$p\"; " +
+      "busctl get-property org.freedesktop.UPower \"$p\" org.freedesktop.UPower.Device " +
+      "ChargeThresholdSupported ChargeThresholdEnabled ChargeEndThreshold; exit 0; done"]
+    stdout: StdioCollector { waitForEnd: true; onStreamFinished: root.updateChargeLimit(text) }
+  }
+
+  Process {
+    id: chargeLimitSetProc
+    onExited: root.refresh()
+  }
+
   Timer { interval: 5000; running: root.opened; repeat: true; onTriggered: root.refresh() }
 
