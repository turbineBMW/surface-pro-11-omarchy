#!/bin/bash
# Offer the Surface Pro 11 extras at the first login after an install, as
# notifications like Omarchy's own first-login toasts: set up face unlock,
# pair the pen. Each is offered once. One that is already set up is never
# offered; one whose package is not installed is offered once it is.
#
# Runs at every login (surface-pro-11-first-login.service) and exits at once
# when there is nothing left to offer.
set -euo pipefail

PATH=/usr/share/omarchy/bin:$PATH

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
offered=$state_home/surface-pro-11/offered
mkdir -p "${offered%/*}"
touch "$offered"
was_offered() { grep -qxF "$1" "$offered"; }
mark_offered() { was_offered "$1" || echo "$1" >>"$offered"; }

pending=()
if ! was_offered toast-face && command -v surface-pro-11-face-setup >/dev/null; then
  if grep -qs surface-pro-11-face-setup /etc/pam.d/omarchy-lock-face; then
    mark_offered toast-face
  else
    pending+=(face)
  fi
fi
if ! was_offered toast-pen && command -v surface-pro-11-pen-pair >/dev/null; then
  if bluetoothctl devices Paired 2>/dev/null | grep -q 'Slim Pen'; then
    mark_offered toast-pen
  else
    pending+=(pen)
  fi
fi
(( ${#pending[@]} )) || exit 0

# The shell has to be up to take a toast, and Omarchy's own first-login toasts
# go out first, so these land on top of them.
omarchy-notification-wait || exit 0
for _ in $(seq 120); do
  omarchy-done check first-run-user >/dev/null 2>&1 && break
  sleep 1
done

for what in "${pending[@]}"; do
  case $what in
    face)
      omarchy-notification-send -u critical -g 󰩉 "Face Unlock" \
        $'Unlock the screen with the IR camera.\nClick to set it up.' \
        --exec omarchy-launch-floating-terminal-with-presentation surface-pro-11-face-setup &&
        mark_offered toast-face
      ;;
    pen)
      omarchy-notification-send -u critical -g 󰏫 "Pair Pen" \
        $'Hold the pen\'s top button 7 s until it blinks,\nthen click here to pair it.' \
        --exec omarchy-launch-floating-terminal-with-presentation surface-pro-11-pen-pair &&
        mark_offered toast-pen
      ;;
  esac
done
