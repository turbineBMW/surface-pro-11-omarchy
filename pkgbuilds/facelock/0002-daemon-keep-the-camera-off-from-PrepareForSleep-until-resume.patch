+    /// Logind announced a suspend: cancel whatever is in flight and cancel
+    /// every request admitted from now until [`Self::end_sleep`].
+    ///
+    /// Cancelling the running request alone is not enough. A lock screen
+    /// locks as the system goes down and starts a face scan when the lock is
+    /// up — after the camera was released — and that scan would open the
+    /// camera and light the IR emitter into the suspend.
+    pub fn begin_sleep(&self) {
+        let slot = self.lock();
+        self.0.sleeping.store(true, Ordering::Release);
+        self.cancel_locked(&slot);
+    }
+
+    /// The system resumed (or the sleep was aborted): admit requests again.
+    pub fn end_sleep(&self) {
+        let _slot = self.lock();
+        self.0.sleeping.store(false, Ordering::Release);
+    }
+
+    /// Whether a suspend is under way, for the preview methods, which run
+    /// one frame per call without a request token.
+    fn is_sleeping(&self) -> bool {
+        self.0.sleeping.load(Ordering::Acquire)
+    }
