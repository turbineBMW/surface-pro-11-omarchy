+/// Take a logind delay inhibitor for sleep, so the suspend waits (up to
+/// logind's `InhibitDelayMaxSec`) until the camera is closed. Released by
+/// dropping the descriptor. Best-effort: without it the release still runs,
+/// it just races the suspend.
+async fn take_sleep_delay(proxy: &zbus::Proxy<'_>) -> Option<zbus::OwnedFd> {
+    match proxy
+        .call(
+            "Inhibit",
+            &(
+                "sleep",
+                "facelock",
+                "Turn the camera and IR emitter off before sleep",
+                "delay",
+            ),
+        )
+        .await
+    {
+        Ok(fd) => Some(fd),
+        Err(e) => {
+            warn!("cannot take a sleep delay inhibitor ({e}); camera release races the suspend");
+            None
+        }
+    }
+}
+
 /// Watch for logind `PrepareForSleep` signals.
 ///
-/// On suspend (arg=true), release the camera so V4L2 handles don't go stale.
-/// On resume (arg=false), just log — the camera will be re-acquired on demand.
+/// On suspend (arg=true), refuse new captures, release the camera so V4L2
+/// handles don't go stale and the IR emitter is off, then let the suspend
+/// proceed. On resume (arg=false), admit captures again — the camera will be
+/// re-acquired on demand.
 ///
 /// Manual testing:
 /// ```bash
 /// # Start daemon, then:
+/// systemd-inhibit --list   # shows facelock, mode delay
 /// sudo systemctl suspend
 /// # After resume, check: journalctl -u facelock-daemon --since "5 min ago"
 /// ```
@@ -2973,7 +3059,10 @@ async fn watch_sleep_signals(
     )
     .await?;
 
+    // Subscribe before taking the inhibitor, so no sleep can be announced in
+    // between that this loop would miss while logind waits on us.
     let mut stream = proxy.receive_signal("PrepareForSleep").await?;
+    let mut sleep_delay = take_sleep_delay(&proxy).await;
     info!("watching logind PrepareForSleep signals for camera suspend/resume");
 
     while let Some(signal) = stream.next().await {
@@ -2982,8 +3071,9 @@ async fn watch_sleep_signals(
             // Lock-free and first: a capture in flight is holding the handler
             // mutex, so its token is the only thing that reaches it. This
             // replaces the old single `try_lock` that gave up with a "handler
-            // busy" warning and left the camera streaming into suspend.
-            current.cancel();
+            // busy" warning and left the camera streaming into suspend. From
+            // here until the resume, new captures are cancelled on admission.
+            current.begin_sleep();
             let handler = handler.clone();
             let _ = tokio::task::spawn_blocking(move || {
                 // The cancelled request exits within one frame and drops the
@@ -3016,10 +3106,20 @@ async fn watch_sleep_signals(
                 }
             })
             .await;
+            // The camera is closed (or closes within a frame): let the
+            // suspend go ahead.
+            drop(sleep_delay.take());
         } else {
+            current.end_sleep();
+            if sleep_delay.is_none() {
+                sleep_delay = take_sleep_delay(&proxy).await;
+            }
             info!("resumed from suspend, camera will reacquire on demand");
         }
     }
+    // The signal stream ended (logind went away): never leave captures
+    // refused for good.
+    current.end_sleep();
     Ok(())
 }
 
@@ -4637,6 +4737,67 @@ impl SyntheticService {
         );
     }
 
+    /// The suspend race: a lock screen starts a face scan after the sleep
+    /// path already released the camera. Every request admitted between
+    /// `PrepareForSleep(true)` and `(false)` must end before the camera
+    /// opens, whichever admission path it takes.
+    #[test]
+    fn requests_admitted_while_sleeping_are_cancelled() {
+        let current = CurrentRequest::default();
+        current.begin_sleep();
+
+        let enroll = CancelToken::new();
+        drop(current.install(enroll.clone()));
+        assert!(
+            enroll.is_cancelled(),
+            "a request installed during sleep reached the camera"
+        );
+
+        // A fresh checkpoint taken after the sleep began: the epoch alone
+        // would admit it.
+        let checkpoint = current.cancellation_epoch();
+        let auth = CancelToken::new();
+        let admitted = current.install_unless_cancelled_since(auth.clone(), checkpoint);
+        assert!(admitted.is_none());
+        assert!(
+            auth.is_cancelled(),
+            "an authentication that began during sleep reached the camera"
+        );
+        assert!(current.is_sleeping());
+    }
+
+    /// Going to sleep also stops the request already running, as before.
+    #[test]
+    fn begin_sleep_cancels_the_installed_request() {
+        let current = CurrentRequest::default();
+        let in_flight = CancelToken::new();
+        let _guard = current.install(in_flight.clone());
+        current.begin_sleep();
+        assert!(in_flight.is_cancelled());
+    }
+
+    /// After the resume, requests run again.
+    #[test]
+    fn requests_after_resume_are_admitted() {
+        let current = CurrentRequest::default();
+        current.begin_sleep();
+        current.end_sleep();
+        assert!(!current.is_sleeping());
+
+        let next = CancelToken::new();
+        drop(current.install(next.clone()));
+        assert!(!next.is_cancelled());
+
+        let checkpoint = current.cancellation_epoch();
+        let auth = CancelToken::new();
+        assert!(
+            current
+                .install_unless_cancelled_since(auth.clone(), checkpoint)
+                .is_some()
+        );
+        assert!(!auth.is_cancelled());
+    }
+
     /// The generation check. Requests overlap at the edges — one is still
     /// finishing while the next has claimed the capture slot — so the older
     /// guard's drop must not clear the newer entry, or the next cancellation
