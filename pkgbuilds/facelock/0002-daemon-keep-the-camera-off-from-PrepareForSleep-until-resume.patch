+/// Between logind's `PrepareForSleep(true)` and `(false)` no capture runs.
+///
+/// The race this closes: the sleep path releases the camera, then a lock
+/// screen locking for the suspend starts its face scan, and the camera and IR
+/// emitter went into the suspend lit.
+#[tokio::test]
+async fn no_capture_runs_while_the_system_is_going_to_sleep() {
+    let svc = matching_service_for("alice");
+    let current = svc.current_request();
+
+    current.begin_sleep();
+    let during = svc
+        .authenticate_as(root(), "alice", CancelToken::new())
+        .await
+        .unwrap();
+    assert!(!during.matched);
+    assert_eq!(during.label, "cancelled", "frozen wire string: {during:?}");
+    assert!(
+        matches!(
+            svc.preview_frame_as(root()).await,
+            Err(fdo::Error::Failed(ref m)) if m.contains("going to sleep")
+        ),
+        "a preview frame ran while the system was going to sleep"
+    );
+
+    current.end_sleep();
+    let after = svc
+        .authenticate_as(root(), "alice", CancelToken::new())
+        .await
+        .unwrap();
+    assert!(
+        after.matched,
+        "the authentication after the resume must run normally: {after:?}"
+    );
+}
+
 /// Each request is born with a fresh token, so a cancellation never outlives
 /// the request it was aimed at.
 ///
