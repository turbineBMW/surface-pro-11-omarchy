pkgname=surface-pro-11-keyring
pkgver=1
pkgrel=1
pkgdesc="Key that signs the surface-pro-11 package repository"
arch=('any')
url="https://github.com/turbineBMW/surface-pro-11-omarchy"
license=('MIT')
install=$pkgname.install
# The public key, written by bin/export-key; the private key lives only with
# the maintainer and in the CI secret.
source=('surface-pro-11.gpg' 'surface-pro-11-trusted' 'surface-pro-11-revoked')
sha256sums=('061301358081eee0c376a777e2902bb3311eaa81a33e890839367861de45f22a'
            '87cab0d4cafb990ea0562e348dbf7674b283289d6f911f2fc9a7fd435969ec21'
            'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855')

package() {
  install -Dm644 -t "$pkgdir/usr/share/pacman/keyrings" \
    surface-pro-11.gpg surface-pro-11-trusted surface-pro-11-revoked
}
